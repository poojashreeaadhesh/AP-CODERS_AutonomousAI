# HTTP port the server listens on.
PORT=3000

# Directory used to persist agent state (data/state.json). Point this at a
# mounted volume in production so state survives restarts and redeploys.
DATA_DIR=./data

# Minutes between autonomous publishing cycles.
# Use 1 for local demos, 75 for judged production (see README).
PUBLISH_INTERVAL_MINUTES=75

# How often the background worker checks whether a cycle is due, in seconds.
AUTONOMOUS_TICK_SECONDS=30

# +/- percentage jitter applied to the publish interval (0-1) so the feed's
# cadence isn't perfectly regular. 0.2 means +/-20%.
PUBLISH_JITTER_PCT=0.2

# Lowest the editorial threshold is allowed to decay to during quiet-cycle
# retries. The agent must still be able to publish nothing - this just
# stops it from staying silent for hours over a temporarily thin topic pool.
EDITORIAL_THRESHOLD_FLOOR=2.0

# Maximum number of consecutive catch-up-paced cycles (8 minutes apart)
# after the scheduler detects the host was asleep past a full interval.
MAX_CATCHUP_POSTS=3

# Optional: enables LLM-backed editorial judgment and post writing.
# Leave unset to run entirely on the deterministic heuristic engine.
ANTHROPIC_API_KEY=

# Kill switch for LLM usage even when a key is present.
LLM_ENABLED=true

# Model used for editorial judgment and post writing.
LLM_MODEL=claude-sonnet-5
