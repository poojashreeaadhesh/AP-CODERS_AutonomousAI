# HTTP port the server listens on.
PORT=3000

# Directory used to persist agent state (data/state.json). Point this at a
# mounted volume in production so state survives restarts and redeploys.
DATA_DIR=./data

# Minutes between autonomous publishing cycles.
# Use 1 for local demos, 75 for judged production (see README).
PUBLISH_INTERVAL_MINUTES=120

# How often the background worker checks whether a cycle is due, in seconds.
AUTONOMOUS_TICK_SECONDS=60

# Optional: enables LLM-backed editorial judgment and post writing.
# Leave unset to run entirely on the deterministic heuristic engine.
ANTHROPIC_API_KEY=

# Kill switch for LLM usage even when a key is present.
LLM_ENABLED=true

# Model used for editorial judgment and post writing.
LLM_MODEL=claude-sonnet-5
